# Backend Environment Variables
# Copy this file to backend/.env and update with your actual values

# Environment
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/sspms

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Cloudflare Turnstile Keys
TURNSTILE_LOCAL_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_PROD_SECRET_KEY=0x4AAAAAAB8L-ebS9kL0zlpcolxXEk6KOEY
